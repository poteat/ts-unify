{
  "name": "@ts-unify/engine",
  "version": "0.0.1",
  "description": "Runtime matching engine for ts-unify",
  "main": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --external @ts-unify/core && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "bench": "esbuild bench/bench.ts --bundle --platform=node --format=esm --packages=external --tsconfig=bench/tsconfig.json --outfile=bench/dist/bench.mjs --log-level=warning && node bench/dist/bench.mjs",
    "bench:profile": "esbuild bench/profile.ts --bundle --platform=node --format=esm --packages=external --tsconfig=bench/tsconfig.json --outfile=bench/dist/profile.mjs --log-level=warning && node --cpu-prof --cpu-prof-dir=bench/dist bench/dist/profile.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@ts-unify/core": "0.0.1"
  },
  "devDependencies": {
    "@typescript-eslint/typescript-estree": "^8.57.2"
  },
  "files": [
    "dist"
  ],
  "license": "MIT"
}
